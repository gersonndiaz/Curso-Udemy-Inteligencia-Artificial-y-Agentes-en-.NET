# ==========================================
# Root .gitignore for .NET & macOS Environment
# ==========================================

# --- Secrets & Sensitive Files ---
# Environment files containing API keys, tokens, or local configurations
.env
.env.*
*.env
*.env.*
secrets.json
usersecrets.json
*.pem
*.key
*.pfx
*.p12
*.cer
*.cert
*.crt
*.der

# --- OS-specific files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- C# / .NET Build Artifacts ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
sgen/
decrypted/
TestResults/

# --- IDE and Editor Settings ---
# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# JetBrains Rider / IntelliJ
.idea/
*.sln.iml
*.idea.info

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Package / Dependency Managers ---
# NuGet
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# --- General System / Backup files ---
*.bak
*.tmp
*.temp
*.log
*.swp
*~
