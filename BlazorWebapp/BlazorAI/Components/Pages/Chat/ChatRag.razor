@page "/chat-rag"
@using BlazorAI.Dto
@using BlazorAI.Helpers
@using BlazorAI.Services.Chatbots
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration

<div class="chat-wrapper">
    <h3 class="chat-header">Chat Documentos Internos</h3>

    <div class="chat-messages" @ref="MessageContainer">
        @foreach(var message in ChatSession.Conversation)
        {
            <div class="message @GetClassCSS(message.Role)">
                <div class="message-header">@GetLabel(message.Role)</div>
                <div class="message-body">
                    @if (string.IsNullOrEmpty(message.Text))
                    {
                        <div class="typing-indicator">
                            <div class="typing-dots" aria-label="La IA está escribiendo" role="status">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>

                    }
                    else
                    {
                        @message.Text
                    }
                </div>
            </div>
        }

        @if (ChatSession.RequestApprovalPending is not null)
        {
            <div class="aprobacion-tool">
                <h4>La IA desea ejecutar una acción sensible</h4>
                <p><strong>Tool:</strong> @ChatSession.RequestApprovalPending.ToolName</p>

                @if (ChatSession.RequestApprovalPending.Arguments.Count > 0)
                {
                    <ul>
                        @foreach (var argumento in ChatSession.RequestApprovalPending.Arguments)
                        {
                            <li><strong>@argumento.Key:</strong> @argumento.Value</li>
                        }
                    </ul>
                }

                <div class="acciones-aprobacion">
                    <button class="btn btn-success"
                            @onclick="Approve"
                            disabled="@ChatSession.IsProcessing">
                        Aprobar
                    </button>

                    <button class="btn btn-danger"
                            @onclick="Decline"
                            disabled="@ChatSession.IsProcessing">
                        Rechazar
                    </button>
                </div>
            </div>
        }
    </div>

    <EditForm Model="model" OnValidSubmit="Submit">
        <div class="input-chat">

            <select class="form-select model-selector"
                @bind="selectedModel"
                @bind:after="OnModelChanged"
                disabled="@(ChatSession.IsProcessing || ChatSession.RequestApprovalPending is not null)">

                @foreach(var item in modelsAvailable)
                {
                    <option value="@item">@item</option>
                }
            </select>

            <input class="form-control"
                @bind="model.Text"
                @bind:event="oninput"
                placeholder="Escribe tu mensaje..." />

                <button type="submit"
                    class="btn btn-primary"
                    disabled="@SubmitDisable">
                </button>
                <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@(!ChatSession.IsProcessing)">
                </button>
        </div>
    </EditForm>
</div>

@code {
    [Inject(Key = "chat-rag")]
    public IChatbot ChatSession { get; set; } = null!;


    private readonly ChatInputModel model = new();
    private ElementReference MessageContainer;
    private bool scrollRequired;

    private bool SubmitDisable => ChatSession.IsProcessing 
            || ChatSession.RequestApprovalPending is not null
            || string.IsNullOrWhiteSpace(model.Text);

    private readonly List<string> modelsAvailable = ModelsAI.GetModelsAvailables().ToList();
    private string selectedModel = ModelsAI.GetModelDefault;

    private void OnModelChanged()
    {
        ChatSession.SetModel(selectedModel);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ChatSession.OnChange += ManageChangeChat;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ollamaUrl = Configuration["AI:OllamaUrl"] ?? "http://localhost:11434";
            await ModelsAI.LoadOllamaModelsAsync(ollamaUrl);

            modelsAvailable.Clear();
            modelsAvailable.AddRange(ModelsAI.GetModelsAvailables());
        }
        catch (HttpRequestException)
        {
            // Ollama no disponible: se mantienen los modelos predefinidos.
        }
    }

    private void ManageChangeChat()
    {
        scrollRequired = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task Approve()
    {
        scrollRequired = true;
        await ChatSession.ResolveApprovalAsync(true);
    }

    private async Task Decline()
    {
        scrollRequired = true;
        await ChatSession.ResolveApprovalAsync(false);
    }

    private async Task Submit()
    {
        var text = model.Text?.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        model.Text = string.Empty;
        scrollRequired = true;

        await ChatSession.SendMessageAsync(text);
    }

    private Task Cancel()
    {
        ChatSession.CancelCurrentResponse();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollRequired)
        {
            scrollRequired = false;
            await JS.InvokeVoidAsync("chatScroll.scrollToBottom", MessageContainer);
        }
    }

    private static string GetLabel(MessageRole role) => role switch
    {
        MessageRole.User => "Tú",
        MessageRole.AI => "IA",
        MessageRole.System => "Sistema",
        _ => role.ToString()
    };

    private static string GetClassCSS(MessageRole role) => role switch
    {
        MessageRole.User => "user",
        MessageRole.AI => "assistant",
        MessageRole.System => "system",
        _ => role.ToString()
    };

    public void Dispose()
    {
        ChatSession.OnChange -= ManageChangeChat;
    }

    private class ChatInputModel
    {
        public string Text { get; set; } = string.Empty;
    }
}
